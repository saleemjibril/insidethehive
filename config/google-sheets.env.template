# Copy these into .env.local (values are not committed).

# From the Google Sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Tab name (create a tab with this exact name in the sheet, or change the value).
GOOGLE_SHEETS_TAB_NAME=Form submissions

# Entire service account JSON as a single line. In the downloaded JSON, the
# private_key contains newlines; replace real newlines with the two characters \n
# when pasting into .env, or stringify in one line for Vercel.
GOOGLE_SERVICE_ACCOUNT_JSON=
